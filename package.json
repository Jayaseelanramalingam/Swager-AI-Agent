{
  "name": "swagger-ai-agent",
  "version": "0.1.0",
  "description": "Enterprise-grade Swagger/OpenAPI AI Agent (Node.js + TypeScript + Express)",
  "main": "dist/src/core/server.js",
  "types": "dist/src/core/server.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/core/server.js",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --poll src/core/server.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "prepare": "husky install"
  },
  "keywords": [
    "openapi",
    "swagger",
    "api-testing",
    "axios",
    "jest",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^11.0.0",
    "axios": "^1.5.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.6.1",
    "eslint": "^8.46.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
